@@ -354,6 +354,21 @@
 void GfxRenderingAPIMetal::UploadTexture(const uint8_t* rgba32_buf, uint32_t width, uint32_t height) {
     if (width == 0 || height == 0) {
         return;
+    }
+
+    // GS_IOS (overlay 0019): Metal aborts the process (no error return) if a
+    // texture dimension exceeds the device limit. ImportTextureRaw's OOB-load
+    // fallback flattens over-requested HD-pack loads into a single line
+    // (e.g. 65536x1), which trips that limit. Clamp and log instead of dying;
+    // the flattened bytes past the clamp are zero-fill/garbage by
+    // construction. bytes_per_row keeps the SOURCE stride so a clamped
+    // region stays row-correct.
+    const uint32_t gsIosSrcWidth = width;
+    const uint32_t gsIosMaxDim = (uint32_t)GetMaxTextureSize();
+    if (width > gsIosMaxDim || height > gsIosMaxDim) {
+        SPDLOG_WARN("UploadTexture: clamping oversized texture {}x{} to device max {}", width, height, gsIosMaxDim);
+        width = width > gsIosMaxDim ? gsIosMaxDim : width;
+        height = height > gsIosMaxDim ? gsIosMaxDim : height;
     }
 
     TextureDataMetal* texture_data = &mTextures[mCurrentTextureIds[mCurrentTile]];
