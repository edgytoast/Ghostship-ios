+static int sSoh3DEye = 0;
+static float sSoh3DSep = 30.0f;
+static float sSoh3DConv = 1000.0f;
+static float sSoh3DConvSmooth = 1000.0f;
+static float sSoh3DPauseMix = 1.0f; // 1 = full stereo, 0 = flat (paused)
+static float sSoh3DAimMix = 0.0f;   // 1 = aiming (C-up first person)
+static int sSoh3DSkybox = 0;        // inside skybox draw (0047 sentinels)
+static float sSoh3DLastP00 = 1.0f;  // last perspective P[0][0] (sky shift)
+static float sSoh3DP[4][4];
+// Off-axis stereo for SM64's perspective-ONLY projection (GHOSTSHIP
+// DIVERGENCE, simpler than every Zelda port): the camera lives in the
+// MODELVIEW stack here, so this matrix's input space is VIEW space —
+// no exported camera basis needed. Row-vector convention (v*M):
+//   eye translate  view_x -= e      ->  row3 += -e * row0
+//   convergence    shear x by z     ->  row2 += (-e/C) * row0
+// so parallax is zero exactly at view depth C. Row0 carries P00 (and any
+// screen-roll mixing), so both terms ride roll consistently, and mirror
+// mode's P-negation flips them with the world (correct handedness).
+// Perspective detect: w-column top-3 (guPerspective sets [2][3]=-1);
+// ortho (HUD/2D) stays exactly on the panel plane — comfort for free —
+// EXCEPT the skybox: SM64 draws its sky through an ORTHO pass, which
+// zero-disparity would park ON the panel, stereoscopically in FRONT of
+// the terrain behind it. Between 0047's sentinels the ortho gets the
+// constant clip-space shift (e/C)*lastP00 — the perspective background-
+// disparity asymptote (lim z->inf of the shear term over w) — landing
+// the sky at infinity.
+static void Soh3DStereoP(float out[4][4], const float in[4][4]) {
+    memcpy(out, in, sizeof(sSoh3DP));
+    const float e = (sSoh3DEye == 2 ? 1.0f : -1.0f) * 0.5f * sSoh3DSep * sSoh3DPauseMix;
+    float sohWx = in[0][3], sohWy = in[1][3], sohWz = in[2][3];
+    if (sohWx * sohWx + sohWy * sohWy + sohWz * sohWz < 0.25f) {
+        if (sSoh3DSkybox && e != 0.0f && sSoh3DConv > 1.0f) {
+            out[3][0] += (e / sSoh3DConv) * sSoh3DLastP00;
+        }
+        return; // orthographic (HUD/2D): stays on the panel plane
+    }
+    if (e == 0.0f) {
+        return;
+    }
+    sSoh3DLastP00 = in[0][0];
+    for (int sohJ = 0; sohJ < 4; sohJ++) {
+        out[3][sohJ] += -e * out[0][sohJ];
+        out[2][sohJ] += (-e / sSoh3DConv) * out[0][sohJ];
+    }
 }
