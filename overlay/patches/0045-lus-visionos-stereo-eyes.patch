+    // instead of swinging with camera distance. SM64 clamp [50,6000] units
+    // (Lakitu orbits ~800-1400; OoT used [30,3000]), fallback 1000.
+    if (eye == 1) { // smooth once per host frame
+        float sohCamD = gSoh3DCamDist;
+        if (!(sohCamD >= 50.0f && sohCamD <= 6000.0f)) {
+            sohCamD = 1000.0f;
+        }
+        sSoh3DConvSmooth += (sohCamD - sSoh3DConvSmooth) * 0.08f;
+        // Flat outside gameplay too: title/file select draw their own
+        // perspective content (goddard head folds lookat INTO projection)
+        // that fights the panel plane.
+        float sohStereoOn = (gSoh3DPaused || !gSoh3DInPlay) ? 0.0f : 1.0f;
+        sSoh3DPauseMix += (sohStereoOn - sSoh3DPauseMix) * 0.15f;
+        if (sSoh3DPauseMix < 0.02f) {
+            sSoh3DPauseMix = 0.0f;
+        }
+        sSoh3DAimMix += ((gSoh3DAiming ? 1.0f : 0.0f) - sSoh3DAimMix) * 0.15f;
+    }
+    auto sohCvars = Ship::Context::GetInstance()->GetConsoleVariables();
+    float sohDepth = sohCvars->GetFloat("gSohIos.StereoDepth", 0.025f);
+    float sohBias = sohCvars->GetFloat("gSohIos.StereoConvBias", 1.0f);
+    // Aiming profile (program-wide tuning: depth 30%, focus 50% while the
+    // first-person C-up camera is up), smoothly blended.
+    float sohAimDepthMul = 1.0f - 0.7f * sSoh3DAimMix;
+    float sohAimBiasMul = 1.0f - 0.5f * sSoh3DAimMix;
+    sSoh3DConv = sSoh3DConvSmooth * sohBias * sohAimBiasMul;
+    sSoh3DSep = sohDepth * sohAimDepthMul * sSoh3DConv;
+    gSoh3DDbgConv = sSoh3DConv;
+    gSoh3DDbgSep = sSoh3DSep;
+    mGameFb = mSoh3DEyeFb[eye - 1][mSoh3DPing];
+    sSoh3DEye = eye;
 }
 
+int Interpreter::Soh3DGetEyeFb(int eye) {
+    return (eye >= 1 && eye <= 2) ? mSoh3DEyeFb[eye - 1][mSoh3DPing] : -1;
+}
+
+void Interpreter::Soh3DEndEyePass(int eye) {
+    // Publish ON GPU COMPLETION, never at commit — the compositor
+    // blit-copies the published texture from its own queue with no
+    // cross-queue fence, and a mid-frame capture contains every pass
+    // EXCEPT the final one (which holds the ImGui overlay): game visible,
+    // menu never. Device-only: the simulator serializes queues.
+    if (eye >= 1 && eye <= 2 && mSoh3DEyeFb[eye - 1][mSoh3DPing] >= 0) {
+        mRapi->Soh3DPublishOnComplete(mSoh3DEyeFb[eye - 1][mSoh3DPing], eye - 1);
+    }
+    mRapi->EndFrameOffscreen();
+    mRapi->FinishRender();
+    if (eye >= 1 && eye <= 2) {
+        gSoh3DEyeFrames[eye - 1] = gSoh3DEyeFrames[eye - 1] + 1;
+    }
+}
