-    } else {
-        SDL_GetWindowSize(mWnd, static_cast<int*>((void*)width), static_cast<int*>((void*)height));
-    }
+    // GS_IOS (overlay 0051): POINTS, not drawable pixels — matches the
+    // reference and 2ship (SDL_GetWindowSize) so the whole UI lays out in
+    // point space. The drawable-pixel value this fork returned here is what
+    // made the menu ~3x too small; overlay 0010 upscales the game image to
+    // the drawable and overlay 0032 upscales the game render, so nothing
